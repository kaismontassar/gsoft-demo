# Demo configuration, loaded by every sbin/*.sh script.
SERVER_ID=gsoft
PROJECT_KEY=gsoft
NPM_RESOLVE_REPO=gsoft-npm-dev-virtual
NPM_DEPLOY_REPO=gsoft-npm-dev-local
NPM_REMOTE_CACHE=gsoft-npm-dev-remote-cache
BUILD_NAME=gsoft-demo
BUILD_NUMBER=11.1
XRAY_WATCH=globalsoft-watch-default
XRAY_VULNERABILITY=XRAY-85679
VULNERABLE_COMMIT=ef92ecd
VULNERABLE_LODASH_VERSION=4.17.11
FIXED_LODASH_VERSION=4.18.1


# Server ID with rights on the Xray policy API (set-policy-block.sh)
POLICY_SERVER_ID=gsoft-voko
# Default browser tabs for open-links.sh when no links are given as arguments
DEMO_LINKS=(
  https://github.com/voko/gsoft-demo-consumer
  https://github.com/voko/gsoft-demo
  https://github.com/voko/gsoft-demo/pulls
  https://jfrogkmm.jfrog.io/ui/admin/xray/policiesGovernance/policies
  https://jfrogkmm.jfrog.io/ui/admin/configuration/integrations/oidc-integrations/edit/globalsoft-github?projectKey=gsoft
  https://cyclonedx.github.io/Sunshine/
)
